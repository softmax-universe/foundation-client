{
  "name": "@softmax-foundation/client",
  "version": "0.1.0",
  "description": "Typed access to Foundation gateway APIs.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/softmax-universe/foundation-factory.git",
    "directory": "workspaces/gateway/client"
  },
  "files": [
    "dist/index.js",
    "dist/index.d.ts",
    "README.md"
  ],
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/build.mts",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "effect": "4.0.7"
  },
  "devDependencies": {
    "@microsoft/api-extractor": "7.60.1",
    "@types/node": "24.13.6",
    "esbuild": "0.28.2",
    "typescript": "7.0.2"
  }
}
